# Local MySQL 9.6 (root, no password) - all data isolated in the esto_portfolio database
DATABASE_URL="mysql://root@127.0.0.1:3306/esto_portfolio"

# --- Railway (production) ---------------------------------------------------
# On Railway the app service reads these from platform variables, not this file.
#   DATABASE_URL  -> reference the MySQL plugin's private URL: ${{ MySQL.MYSQL_URL }}
#   PORT          -> injected automatically by Railway (main.ts binds it)
# To load data from your local machine, temporarily set DATABASE_URL to the
# MySQL plugin's PUBLIC proxy URL (Variables tab -> MYSQL_PUBLIC_URL), e.g.:
#   DATABASE_URL="mysql://root:PASSWORD@HOST.proxy.rlwy.net:PORT/railway"

# Original ESTO database (read-only source for the ETL importer, kept local)
SOURCE_DATABASE_URL="mysql://root@127.0.0.1:3306/techportfolio"

# API
API_PORT=3001
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# Gemini (Help Agent on the search site). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Single seeded admin (used by prisma db seed)
ADMIN_EMAIL="admin@esto.local"
ADMIN_PASSWORD="changeme123"

# Scraper
ESTO_BASE_URL="https://esto.nasa.gov/TechPortfolio"

# Web (Vite) - leave empty in production so the SPA calls the same-origin /api.
# Only set this for local dev when the API runs on a different port.
VITE_API_BASE_URL="http://localhost:3001/api"
